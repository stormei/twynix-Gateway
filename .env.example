TB_MQTT_URL=mqtt://thingsboard.example.local:1883
TB_ACCESS_TOKEN=YOUR_DEVICE_TOKEN
MQTT_CLIENT_ID=edge-gw-01
MQTT_CLEAN_SESSION=true
TB_MAPPED_DEVICE_TRANSPORT=gateway-api
TB_REJECT_UNAUTHORIZED=true
TB_TLS_CA=
TB_TLS_CERT=
TB_TLS_KEY=

# Publish normalized OPC UA alarm events as device telemetry for a generic ThingsBoard rule chain.
# No ThingsBoard tenant/admin REST credential is stored in the gateway.
TB_ALARM_EVENTS_ENABLED=false
TB_ALARM_EVENT_TELEMETRY_KEY=twynix_opcua_alarm_event
TB_ALARM_STATE_PATH=/data/opcua-alarm-state.json
TB_ALARM_CRITICAL_MIN=900
TB_ALARM_MAJOR_MIN=800
TB_ALARM_WARNING_MIN=600
TB_ALARM_MINOR_MIN=300

# Use /data paths when running Docker. Use ./data paths for local npm start.
SQLITE_PATH=/data/messages.db
SQLITE_MAX_ROWS=50000
MQTT_FLUSH_BATCH_SIZE=200
MQTT_FLUSH_DELAY_MS=0
MQTT_FLUSH_INTERVAL_MS=15000

OPCUA_URL=opc.tcp://opcua.example.local:49320
OPCUA_USERNAME=
OPCUA_PASSWORD=
OPCUA_APPLICATION_URI=urn:twynix:opcua-gateway:docker
OPCUA_SAMPLING_MS=250
OPCUA_PUBLISHING_INTERVAL_MS=1000
OPCUA_LIFETIME_COUNT=60
OPCUA_MAX_KEEPALIVE_COUNT=5
OPCUA_MAX_NOTIFICATIONS_PER_PUBLISH=100
OPCUA_MONITORED_ITEM_QUEUE_SIZE=10
OPCUA_PUBLISH_REQUEST_PIPELINE=1
OPCUA_ALARMS_ENABLED=false

DEVICE_NAME=Machine001
APP_VERSION=0.2.0
BUILD_SHA=local
LOG_LEVEL=info
LOG_DIR=/data/logs
RECENT_LOG_LIMIT=1000
HEALTH_PORT=8080
CONFIG_PATH=/data/config.json
CONFIG_RECONCILE_INTERVAL_MS=5000

ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH_FILE=/data/admin-password-hash
# Option A: set ADMIN_PASSWORD and Docker will generate/persist a hash in /data/admin-password-hash.
# Option B: leave both empty and Docker will generate a random password and print it once in logs.
# Option C: set ADMIN_PASSWORD_HASH directly if you already have a scrypt hash.
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
# Keep false for direct http://host:8080 access. Set true only behind HTTPS.
ADMIN_COOKIE_SECURE=false

WRITE_MIN_INTERVAL_MS=100
RPC_JOURNAL_PATH=/data/rpc-journal.db
RPC_JOURNAL_MAX_ROWS=200000
