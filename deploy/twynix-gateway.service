[Unit]
Description=TwynIX OPC UA Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/twynix-gateway
EnvironmentFile=/etc/twynix-gateway.env
ExecStart=/usr/bin/node /opt/twynix-gateway/dist/index.js
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/twynix-gateway/data /opt/twynix-gateway/config.json

[Install]
WantedBy=multi-user.target
